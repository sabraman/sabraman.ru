{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "react", "nextjs", "vitest"],
	"categories": {
		"correctness": "error"
	},
	"rules": {
		"nextjs/no-img-element": "off",
		"unicorn/no-useless-spread": "off"
	},
	"env": {
		"builtin": true,
		"browser": true
	},
	"ignorePatterns": [
		"**/node_modules/**",
		".git/**",
		".claude/**",
		".codex-artifacts/**",
		".playwright-mcp/**",
		".reference/**",
		".trae/**",
		"tmp/**"
	]
}
